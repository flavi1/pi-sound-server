#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# =============================================================================
#  audio-hub — pi-sound-server (PipeWire + WirePlumber + Mopidy + knob)
#
#  Toute la configuration vient d'UN fichier : /etc/pi-sound-server/audio-hub.conf
#
#  sudo audio-hub apply        génère les configs PipeWire/WirePlumber/Mopidy,
#                              met à jour /boot/firmware/config.txt (HAT, audio
#                              intégré, HDMI) et redémarre la pile audio
#  sudo audio-hub list         périphériques audio détectés + propriétés utiles
#                              pour écrire les lignes match.*
#  sudo audio-hub status       état du routage (MASTER, entrées, sorties, liens)
#  sudo audio-hub knob-list    périphériques d'entrée utilisables comme knob
#  sudo audio-hub diag         rapport de diagnostic complet (+ test du knob)
#  sudo audio-hub volume       volume de MASTER (en % et en dB)
#  sudo audio-hub volume watch affichage en direct (pour tester le knob)
#  sudo audio-hub volume +5% | -5% | 40% | 0.4 | mute | unmute
#  audio-hub check             valide le fichier et affiche ce qui serait généré
#  audio-hub generate DIR      écrit les fichiers générés dans DIR (test)
#  audio-hub boot-config FICHIER   affiche le config.txt qui serait écrit (test)
#
#  Usage interne (services systemd de l'utilisateur audio) :
#  audio-hub init              attend MASTER, le met par défaut, restaure le volume
#  audio-hub knob              démon du bouton de volume USB
#  audio-hub links             démon : relie chaque entrée à MASTER seulement
#                              quand elle fournit réellement du son, et rallume
#                              les appareils USB revenus sur le profil « off »
#
#  Service système (root) :
#  audio-hub bluetooth         enceinte Bluetooth : visible, jumelage par code PIN
#                              obligatoire (section [bluetooth]), appareils jumelés
#                              marqués de confiance (reconnexion automatique)
# =============================================================================
import configparser
import glob
import json
import math
import os
import pwd
import re
import select
import shutil
import socket
import struct
import subprocess
import sys
import time
import urllib.request

CONF = os.environ.get("AUDIO_HUB_CONF", "/etc/pi-sound-server/audio-hub.conf")
GEN_HEADER = ("# Généré par « audio-hub apply » depuis %s\n"
              "# NE PAS ÉDITER : modifiez le fichier source puis relancez « sudo audio-hub apply ».\n\n")

DEVICE_KEYS = {"description", "rate", "format", "driver-priority", "period-size",
               "headroom", "enabled", "volume", "gain-db"}
GLOBAL_DEFAULTS = {
    "user": "hifi",
    "master.name": "MASTER",
    "master.description": "MASTER",
    "clock.rate": "192000",
    "clock.allowed-rates": "192000",
    "clock.quantum": "1024",
    "clock.min-quantum": "512",
    "clock.max-quantum": "4096",
    "resample.quality": "10",
    "master.initial-volume": "0.25",
    "master.max-volume": "1.0",
    "latency-compensate": "false",
    "disable-unlisted": "no",
}
KNOB_DEFAULTS = {"enabled": "yes", "device": "auto", "step": "0.02", "press": "mute", "grab": "yes"}
BOOT_DEFAULTS = {"manage": "yes", "file": "auto", "overlay": "iqaudio-dacplus,unmute_amp",
                 "disable-onboard-audio": "yes", "disable-hdmi-audio": "yes"}
MOPIDY_DEFAULTS = {"enabled": "yes", "http.port": "6680", "mpd.port": "6600",
                   "media-dirs": "/media", "iris": "yes", "scan-interval-minutes": "60",
                   "extra-codecs": "no", "fixed-format": "yes"}
# Bluetooth désactivé si la section est absente : ouvrir une interface radio doit
# être un choix explicite (le modèle audio-hub.conf l'active).
BT_DEFAULTS = {"enabled": "no", "name": "auto", "pin": "1234", "discoverable": "yes"}
BT_UNIT = "audio-hub-bluetooth.service"
BT_CLASS = 0x0414            # classe d'appareil : Audio/Vidéo, haut-parleur


def die(msg):
    print("audio-hub: " + msg, file=sys.stderr)
    sys.exit(1)


def log(msg):
    print(msg, flush=True)


def yes(v):
    return str(v).strip().lower() in ("1", "yes", "true", "on", "oui")


# =============================================================================
#  Lecture et validation de la configuration
# =============================================================================
class Device:
    def __init__(self, kind, ident, sec):
        self.kind = kind          # "output" | "input"
        self.id = ident
        self.opts = {}
        self.match = {}
        for k, v in sec.items():
            if k.startswith("match."):
                self.match[k[6:]] = v.strip()
            elif k in DEVICE_KEYS:
                self.opts[k] = v.strip()
            else:
                die("[%s.%s] option inconnue : %s" % (kind, ident, k))
        if not self.match:
            die("[%s.%s] il faut au moins une ligne match.<propriété> = valeur" % (kind, ident))
        for k in ("rate", "driver-priority", "period-size", "headroom"):
            if k in self.opts and not self.opts[k].isdigit():
                die("[%s.%s] %s doit être un entier" % (kind, ident, k))
        if "gain-db" in self.opts:
            try:
                g = float(self.opts["gain-db"].replace("+", ""))
            except ValueError:
                die("[%s.%s] gain-db doit être un nombre (ex. 6 ou -3.5)" % (kind, ident))
            if not -40 <= g <= 24:
                die("[%s.%s] gain-db hors limites (-40 à +24 dB)" % (kind, ident))
        if "volume" in self.opts:
            try:
                float(self.opts["volume"])
            except ValueError:
                die("[%s.%s] volume doit être un nombre (0.0..1.0)" % (kind, ident))

    @property
    def enabled(self):
        return yes(self.opts.get("enabled", "yes"))

    @property
    def node_name(self):
        return "hub.%s.%s" % ("out" if self.kind == "output" else "in", self.id)

    @property
    def description(self):
        return self.opts.get("description", "%s %s" % (self.kind, self.id))


class Config:
    def __init__(self, path=CONF):
        if not os.path.exists(path):
            die("fichier introuvable : " + path)
        cp = configparser.ConfigParser(interpolation=None, comment_prefixes=("#", ";"),
                                       inline_comment_prefixes=None, strict=True)
        cp.optionxform = str
        try:
            cp.read(path, encoding="utf-8")
        except configparser.Error as e:
            die("erreur de syntaxe dans %s :\n%s" % (path, e))
        self.path = path
        self.g = dict(GLOBAL_DEFAULTS)
        self.knob = dict(KNOB_DEFAULTS)
        self.mopidy = dict(MOPIDY_DEFAULTS)
        self.boot = dict(BOOT_DEFAULTS)
        self.bt = dict(BT_DEFAULTS)
        self.outputs, self.inputs = [], []
        for name in cp.sections():
            sec = dict(cp.items(name))
            if name == "global":
                self._merge(self.g, sec, name)
            elif name == "knob":
                self._merge(self.knob, sec, name)
            elif name == "mopidy":
                self._merge(self.mopidy, sec, name)
            elif name == "boot":
                self._merge(self.boot, sec, name)
            elif name == "bluetooth":
                self._merge(self.bt, sec, name)
            elif name.startswith("output.") or name.startswith("input."):
                kind, ident = name.split(".", 1)
                if not re.fullmatch(r"[A-Za-z0-9_-]+", ident):
                    die("[%s] identifiant invalide (lettres, chiffres, _ et -)" % name)
                (self.outputs if kind == "output" else self.inputs).append(Device(kind, ident, sec))
            else:
                die("section inconnue : [%s]" % name)
        for k in ("clock.rate", "clock.quantum", "clock.min-quantum", "clock.max-quantum",
                  "resample.quality"):
            if not self.g[k].isdigit():
                die("[global] %s doit être un entier" % k)
        if not re.fullmatch(r"[0-9]{4,16}", self.bt["pin"]):
            die("[bluetooth] pin doit compter 4 à 16 chiffres (ex. 1234)")
        if not self.bt["name"]:
            die("[bluetooth] name ne peut pas être vide (auto = nom de la machine)")
        self.allowed_rates = [int(x) for x in re.split(r"[\s,]+", self.g["clock.allowed-rates"].strip()) if x]
        if int(self.g["clock.rate"]) not in self.allowed_rates:
            self.allowed_rates.insert(0, int(self.g["clock.rate"]))
        try:
            pw = pwd.getpwnam(self.user)
            self.uid, self.home = pw.pw_uid, pw.pw_dir
        except KeyError:
            self.uid, self.home = None, "/home/" + self.user

    @staticmethod
    def _merge(dst, src, name):
        for k, v in src.items():
            if k not in dst:
                die("[%s] option inconnue : %s" % (name, k))
            dst[k] = v.strip()

    @property
    def user(self):
        return self.g["user"]

    @property
    def master(self):
        return self.g["master.name"]

    @property
    def bt_enabled(self):
        return yes(self.bt["enabled"])

    @property
    def bt_name(self):
        n = self.bt["name"]
        return socket.gethostname() if n.lower() == "auto" else n

    @property
    def max_volume(self):
        return min(1.5, max(0.0, float(self.g["master.max-volume"])))


# =============================================================================
#  Écriture SPA-JSON (format des fichiers PipeWire / WirePlumber)
# =============================================================================
def spa(v, ind=0):
    pad, pad2 = "    " * ind, "    " * (ind + 1)
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        if all(not isinstance(x, (dict, list)) for x in v):
            return "[ " + " ".join(spa(x) for x in v) + " ]"
        return "[\n" + "".join(pad2 + spa(x, ind + 1) + "\n" for x in v) + pad + "]"
    if isinstance(v, dict):
        out = "{\n"
        for k, x in v.items():
            key = k if re.fullmatch(r"[A-Za-z0-9_.\-]+", k) else json.dumps(k)
            out += "%s%s = %s\n" % (pad2, key, spa(x, ind + 1))
        return out + pad + "}"
    raise TypeError(v)


def spa_top(d):
    return "".join("%s = %s\n\n" % (k, spa(v)) for k, v in d.items())


# =============================================================================
#  Génération
# =============================================================================
def gen_pipewire(c):
    master = c.master
    stream_rules = []
    for d in c.outputs:
        if not d.enabled:
            continue
        stream_rules.append({
            "matches": [{"media.class": "Audio/Sink", "node.name": d.node_name}],
            "actions": {"create-stream": {}},
        })
    modules = [{
        "name": "libpipewire-module-combine-stream",
        "args": {
            "combine.mode": "sink",
            "node.name": master,
            "node.description": c.g["master.description"],
            "combine.latency-compensate": yes(c.g["latency-compensate"]),
            "combine.props": {
                "audio.position": ["FL", "FR"],
                "priority.session": 3000,
                "node.pause-on-idle": False,
            },
            "stream.props": {
                "resample.quality": int(c.g["resample.quality"]),
            },
            "stream.rules": stream_rules,
        },
    }]
    for d in c.inputs:
        if not d.enabled:
            continue
        base = "hub.loop.%s" % d.id
        modules.append({
            "name": "libpipewire-module-loopback",
            "args": {
                "node.description": "%s -> %s" % (d.description, master),
                "audio.position": ["FL", "FR"],
                "capture.props": {
                    "node.name": base + ".capture",
                    "node.description": "%s (capture)" % d.description,
                    "target.object": d.node_name,
                    # Attendre l'appareil s'il est absent, ne jamais se rabattre
                    # sur une autre entrée, se raccrocher seul à son retour.
                    "node.dont-fallback": True,
                    "node.linger": True,
                    "node.dont-move": True,
                    "resample.quality": int(c.g["resample.quality"]),
                },
                "playback.props": {
                    "node.name": base + ".playback",
                    "node.description": "%s -> %s" % (d.description, master),
                    # Pas de lien automatique vers MASTER : tant que l'entrée n'a
                    # jamais fourni de données, la boucle peut émettre des valeurs
                    # invalides qui rendent tout MASTER muet. « audio-hub links »
                    # ne crée le lien que lorsque la capture tourne vraiment.
                    "node.autoconnect": False,
                    "node.dont-move": True,
                    "resample.quality": int(c.g["resample.quality"]),
                },
            },
        })
    doc = {
        "context.properties": {
            "default.clock.rate": int(c.g["clock.rate"]),
            "default.clock.allowed-rates": c.allowed_rates,
            "default.clock.quantum": int(c.g["clock.quantum"]),
            "default.clock.min-quantum": int(c.g["clock.min-quantum"]),
            "default.clock.max-quantum": int(c.g["clock.max-quantum"]),
        },
        "stream.properties": {"resample.quality": int(c.g["resample.quality"])},
        "context.modules": modules,
    }
    return GEN_HEADER % c.path + spa_top(doc)


def gen_client(c):
    doc = {"stream.properties": {"resample.quality": int(c.g["resample.quality"])}}
    return GEN_HEADER % c.path + spa_top(doc)


def gen_wireplumber(c):
    rules = []
    # 1) Tous les nœuds ALSA : jamais de mise en veille (pas de « clac » sur
    #    l'ampli, pas de latence au démarrage), éventuellement désactivés.
    common = {"session.suspend-timeout-seconds": 0, "node.pause-on-idle": False}
    if yes(c.g["disable-unlisted"]):
        common["node.disabled"] = True
    rules.append({"matches": [{"node.name": "~alsa_.*"}],
                  "actions": {"update-props": common}})
    # 2) Chaque candidat : renommé en hub.out.<id> / hub.in.<id> + réglages
    for d in c.outputs + c.inputs:
        if not d.enabled:
            continue
        m = {"media.class": "Audio/Sink" if d.kind == "output" else "Audio/Source"}
        m.update(d.match)
        props = {
            "node.name": d.node_name,
            "node.description": d.description,
            "node.nick": d.description,
            "node.disabled": False,
            "priority.session": 500,
            "resample.quality": int(c.g["resample.quality"]),
        }
        o = d.opts
        if "rate" in o:
            props["audio.rate"] = int(o["rate"])
        if "format" in o:
            props["audio.format"] = o["format"]
        if "driver-priority" in o:
            props["priority.driver"] = int(o["driver-priority"])
        elif d.kind == "input":
            props["priority.driver"] = 100     # une entrée ne pilote jamais l'horloge
        if "period-size" in o:
            props["api.alsa.period-size"] = int(o["period-size"])
        if "headroom" in o:
            props["api.alsa.headroom"] = int(o["headroom"])
        rules.append({"matches": [m], "actions": {"update-props": props}})
    doc = {
        "wireplumber.settings": {
            # Volume matériel des nouveaux appareils : 100 % (c'est MASTER qui règle)
            "device.routes.default-sink-volume": 1.0,
            "device.routes.default-source-volume": 1.0,
        },
        # Pas de réservation D-Bus des cartes son (aucune session graphique)
        "monitor.alsa.properties": {"alsa.reserve": False},
        "monitor.alsa.rules": rules,
    }
    return GEN_HEADER % c.path + spa_top(doc)


def gen_wireplumber_bt(c):
    """Bluetooth : la Pi est une enceinte (A2DP « sink »). Aucune fréquence ni aucun
    codec imposé : chaque téléphone négocie ce qu'il sait faire (SBC, AAC, aptX,
    LDAC…), PipeWire rééchantillonne vers MASTER. Le flux d'un téléphone est relié à
    la sortie par défaut, c'est-à-dire MASTER."""
    if not c.bt_enabled:
        doc = {"wireplumber.profiles": {"main": {"monitor.bluez": "disabled"}}}
        return GEN_HEADER % c.path + spa_top(doc)
    doc = {
        # Pas de session graphique (logind « seat ») : sans cela, WirePlumber
        # n'active le Bluetooth que pour un utilisateur connecté à l'écran.
        "wireplumber.profiles": {"main": {"monitor.bluez.seat-monitoring": "disabled"}},
        "monitor.bluez.properties": {
            "bluez5.roles": ["a2dp_sink"],          # recevoir de la musique, rien d'autre
            "bluez5.hfphsp-backend": "none",        # pas de profil téléphone / micro
        },
        "monitor.bluez.rules": [{
            "matches": [{"node.name": "~bluez_input.*"}],
            "actions": {"update-props": {
                "priority.driver": 100,              # ne pilote jamais l'horloge
                "session.suspend-timeout-seconds": 0,
            }},
        }],
    }
    return GEN_HEADER % c.path + spa_top(doc)


def mopidy_output(c):
    """Sortie GStreamer de Mopidy. Avec fixed-format (défaut), tout morceau est converti
    en flottant 32 bits stéréo à la fréquence de MASTER AVANT pipewiresink : la sortie
    ne change jamais de format d'un morceau à l'autre. Sans cela, l'enchaînement sans
    blanc entre deux fichiers de fréquence ou de format différents fait parfois
    renégocier pipewiresink en pleine lecture : son haché et suraigu, ou souffle."""
    sink = "pipewiresink target-object=%s client-name=Mopidy" % c.master
    if not yes(c.mopidy["fixed-format"]):
        return sink
    q = min(10, int(c.g["resample.quality"]))      # 10 = maximum de GStreamer
    return ("audioconvert ! audioresample quality=%d ! "
            "audio/x-raw,format=F32LE,rate=%s,channels=2 ! %s" % (q, c.g["clock.rate"], sink))


def gen_mopidy(c):
    m = c.mopidy
    dirs = [x.strip() for x in m["media-dirs"].split(",") if x.strip()]
    file_dirs = "\n".join("    %s|%s" % (p, os.path.basename(p.rstrip("/")) or p) for p in dirs)
    iris = yes(m["iris"])
    excl = ".directory .html .jpeg .jpg .log .nfo .pdf .png .txt .zip .cue .m3u .db .ini .gif .bmp .webp"
    return (GEN_HEADER % c.path) + """[core]
restore_state = true

[logging]
verbosity = 0

[audio]
# Mopidy joue dans MASTER, qui distribue vers toutes les sorties
# (format fixe : [mopidy] fixed-format dans audio-hub.conf)
output = {output}
mixer = software
mixer_volume = 100

[http]
enabled = true
hostname = ::
port = {http}
{default_app}
[mpd]
enabled = true
hostname = ::
port = {mpd}

[file]
enabled = true
media_dirs =
{file_dirs}
follow_symlinks = false
show_dotfiles = false
excluded_file_extensions = {excl}

[local]
enabled = true
media_dir = {local_dir}
excluded_file_extensions = {excl}

[m3u]
enabled = true

[stream]
enabled = true
{iris_sec}""".format(output=mopidy_output(c), http=m["http.port"], mpd=m["mpd.port"],
                     default_app="default_app = iris\n" if iris else "",
                     file_dirs=file_dirs, excl=excl, local_dir=dirs[0] if dirs else "/media",
                     iris_sec="\n[iris]\ncountry = FR\nlocale = fr_FR\n" if iris else "")


def gen_scan_timer(c):
    mins = max(5, int(c.mopidy["scan-interval-minutes"] or 60))
    return """# Généré par audio-hub
[Unit]
Description=Réindexation périodique de la bibliothèque Mopidy

[Timer]
OnBootSec=3min
OnUnitActiveSec={m}min

[Install]
WantedBy=timers.target
""".format(m=mins)


# =============================================================================
#  /boot/firmware/config.txt : HAT, audio intégré, audio HDMI
# =============================================================================
BOOT_BEGIN = "# >>> pi-sound-server"
BOOT_END = "# <<< pi-sound-server"
BOOT_OFF = "#pi-sound-server# "      # préfixe des lignes désactivées (réversible)


def boot_file(c):
    f = c.boot["file"].strip()
    if f and f != "auto":
        return f
    for cand in ("/boot/firmware/config.txt", "/boot/config.txt"):
        if os.path.exists(cand):
            return cand
    return "/boot/firmware/config.txt"


def boot_transform(text, c):
    """Renvoie le nouveau config.txt. Toutes les modifications sont réversibles :
    - bloc « pi-sound-server » (overlay du HAT) remplacé à chaque passage ;
    - dtparam=audio=on commenté avec un préfixe reconnaissable ;
    - dtoverlay=disable-bt commenté de même quand le Bluetooth est activé ;
    - paramètre « noaudio » ajouté/retiré sur la ligne dtoverlay=vc4-kms-v3d."""
    lines = text.splitlines()
    out, inside = [], False
    for l in lines:                       # 1) retirer l'ancien bloc
        if l.strip() == BOOT_BEGIN:
            inside = True
            continue
        if l.strip() == BOOT_END:
            inside = False
            continue
        if not inside:
            out.append(l)
    while out and not out[-1].strip():
        out.pop()
    manage = yes(c.boot["manage"])
    off_onboard = manage and yes(c.boot["disable-onboard-audio"])
    off_hdmi = manage and yes(c.boot["disable-hdmi-audio"])
    bt_on = manage and c.bt_enabled
    bt_re = re.compile(r"^\s*dtoverlay=(?:pi3-)?disable-bt\s*(?:#.*)?$")
    res = []
    for l in out:
        # 2) audio intégré (jack 3,5 mm) et Bluetooth : lignes commentées par nous
        if l.startswith(BOOT_OFF):
            orig = l[len(BOOT_OFF):]
            keep_off = bt_on if bt_re.match(orig) else off_onboard
            res.append(BOOT_OFF + orig if keep_off else orig)
            continue
        if re.match(r"^\s*dtparam=audio=on\s*$", l) and off_onboard:
            res.append(BOOT_OFF + l)
            continue
        if bt_re.match(l) and bt_on:
            res.append(BOOT_OFF + l)
            continue
        # 3) audio HDMI : paramètre noaudio de l'overlay vidéo KMS
        m = re.match(r"^(\s*dtoverlay=vc4-(?:f)?kms-v3d[^,\s]*)((?:,[^\s#]*)?)(\s*(?:#.*)?)$", l)
        if m:
            params = [p for p in m.group(2).split(",") if p]
            params = [p for p in params if p != "noaudio"]
            if off_hdmi:
                params.append("noaudio")
            res.append(m.group(1) + "".join("," + p for p in params) + m.group(3))
            continue
        res.append(l)
    if manage:
        res += ["", BOOT_BEGIN,
                "# Géré par « audio-hub apply » depuis %s — ne pas éditer ce bloc." % c.path,
                "[all]"]
        if off_onboard:
            res.append("dtparam=audio=off")
        ov = c.boot["overlay"].strip()
        if ov and ov.lower() != "none":
            res.append("dtoverlay=" + ov)
        res.append(BOOT_END)
    return "\n".join(res) + "\n"


def apply_boot(c):
    """Écrit config.txt si nécessaire. Renvoie True si un redémarrage est requis."""
    path = boot_file(c)
    if not os.path.exists(path):
        log("  %s absent : configuration de démarrage ignorée" % path)
        return False
    old = open(path, encoding="utf-8").read()
    new = boot_transform(old, c)
    if new == old:
        log("  %s : inchangé" % path)
        return False
    bak = path + ".pi-sound-server.orig"
    if not os.path.exists(bak):
        shutil.copy2(path, bak)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(tmp, path)
    os.sync()
    open("/var/run/reboot-required", "a").close()
    log("  %s mis à jour (sauvegarde : %s)" % (path, bak))
    log("  ** REDÉMARRAGE NÉCESSAIRE (HAT, audio intégré ou Bluetooth) : sudo reboot **")
    return True


def gen_scan_path(c):
    return """# Généré par audio-hub
# Un dossier apparaît / disparaît dans /media (disque branché, débranché, peu
# importe qui l'a monté) => réindexation de la bibliothèque Mopidy.
[Unit]
Description=Surveillance de {d} pour Mopidy

[Path]
PathChanged={d}
Unit=mopidy-scan.service

[Install]
WantedBy=default.target
""".format(d=[x.strip() for x in c.mopidy["media-dirs"].split(",") if x.strip()][0])


def generated_files(c):
    """chemin relatif au HOME de l'utilisateur -> contenu"""
    return {
        ".config/pipewire/pipewire.conf.d/50-audio-hub.conf": gen_pipewire(c),
        ".config/pipewire/client.conf.d/50-audio-hub.conf": gen_client(c),
        ".config/wireplumber/wireplumber.conf.d/50-audio-hub.conf": gen_wireplumber(c),
        ".config/wireplumber/wireplumber.conf.d/51-audio-hub-bluetooth.conf": gen_wireplumber_bt(c),
        ".config/mopidy/mopidy.conf": gen_mopidy(c),
        ".config/systemd/user/mopidy-scan.timer": gen_scan_timer(c),
        ".config/systemd/user/mopidy-scan.path": gen_scan_path(c),
    }


# =============================================================================
#  Exécution en tant qu'utilisateur audio
# =============================================================================
def user_env(c):
    env = dict(os.environ)
    env["XDG_RUNTIME_DIR"] = "/run/user/%d" % c.uid
    env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=/run/user/%d/bus" % c.uid
    return env


def as_user(c, cmd, check=False, capture=True):
    if c.uid is None:
        die("l'utilisateur « %s » n'existe pas (lancez l'installeur)" % c.user)
    if os.geteuid() == c.uid:
        full = cmd
    elif os.geteuid() == 0:
        full = ["runuser", "-u", c.user, "--"] + cmd
    else:
        die("à lancer avec sudo (ou en tant que « %s »)" % c.user)
    r = subprocess.run(full, env=user_env(c), text=True,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None)
    if check and r.returncode != 0:
        die("échec : %s\n%s" % (" ".join(cmd), (r.stderr or "").strip()))
    return r


def systemctl_user(c, *args):
    if os.geteuid() == c.uid:
        cmd = ["systemctl", "--user"] + list(args)
    else:
        cmd = ["systemctl", "--user", "-M", "%s@" % c.user] + list(args)
    return subprocess.run(cmd, text=True, capture_output=True)


def pw_nodes(c):
    r = as_user(c, ["pw-dump"])
    if r.returncode != 0:
        return []
    try:
        objs = json.loads(r.stdout)
    except ValueError:
        return []
    out = []
    for o in objs:
        if o.get("type") == "PipeWire:Interface:Node":
            props = (o.get("info") or {}).get("props") or {}
            out.append((o["id"], props, (o.get("info") or {}).get("state")))
    return out


def node_id(c, name):
    for nid, props, _ in pw_nodes(c):
        if props.get("node.name") == name:
            return nid
    return None


# =============================================================================
#  Commandes
# =============================================================================
def write_owned(path, content, uid, gid, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    d = os.path.dirname(path)
    # remonter les dossiers créés sous le HOME pour leur donner le bon propriétaire
    while d and d != "/" and uid is not None:
        try:
            st = os.stat(d)
        except FileNotFoundError:
            break
        if st.st_uid == uid:
            break
        if d.count("/") <= 2:   # ne jamais toucher /home ni le HOME lui-même ici
            break
        os.chown(d, uid, gid)
        d = os.path.dirname(d)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    os.chmod(path, mode)
    if uid is not None:
        os.chown(path, uid, gid)


def cmd_check(c):
    print("Configuration valide : %s" % c.path)
    print("  utilisateur  : %s" % c.user)
    print("  MASTER       : %s @ %s Hz (autorisées : %s)" % (c.master, c.g["clock.rate"], c.allowed_rates))
    for d in c.outputs:
        print("  sortie %-12s -> %-22s %s %s" % (d.id, d.node_name, "" if d.enabled else "[désactivée]", d.match))
    for d in c.inputs:
        print("  entrée %-12s -> %-22s %s %s" % (d.id, d.node_name, "" if d.enabled else "[désactivée]", d.match))
    print("  knob         : %s (%s)" % ("actif" if yes(c.knob["enabled"]) else "inactif", c.knob["device"]))
    print("  mopidy       : %s" % ("actif" if yes(c.mopidy["enabled"]) else "inactif"))
    if c.bt_enabled:
        print("  bluetooth    : actif, nom « %s », code PIN %s, %s" % (
            c.bt_name, c.bt["pin"], "visible" if yes(c.bt["discoverable"]) else "invisible"))
    else:
        print("  bluetooth    : inactif")


def cmd_generate(c, outdir):
    for rel, content in generated_files(c).items():
        p = os.path.join(outdir, rel)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            f.write(content)
        print("écrit", p)


def apply_bluetooth(c):
    """Service système audio-hub-bluetooth (root) : activé / désactivé selon la config,
    redémarré pour relire le code PIN et le nom."""
    legacy = os.path.join(c.home, ".config/wireplumber/wireplumber.conf.d/60-bluetooth.conf")
    if os.path.exists(legacy):
        log("  ATTENTION : %s (réglage manuel) fait doublon : supprimez-le" % legacy)
    if not os.path.exists("/etc/systemd/system/" + BT_UNIT):
        log("  service %s absent : relancez sudo bash /opt/pi-sound-server/install.sh" % BT_UNIT)
        return

    def sc(*a):
        return subprocess.run(["systemctl"] + list(a), text=True, capture_output=True)

    if not c.bt_enabled:
        sc("disable", "--now", BT_UNIT)
        sc("disable", "--now", "bluetooth.service")
        log("  Bluetooth désactivé")
        return
    if not shutil.which("bluetoothctl"):
        log("  BlueZ absent : relancez sudo bash /opt/pi-sound-server/install.sh")
        return
    sc("daemon-reload")
    sc("enable", "--now", "bluetooth.service")
    sc("enable", BT_UNIT)
    r = sc("restart", BT_UNIT)
    if r.returncode != 0:
        log("  %s : échec du démarrage (journalctl -u %s)" % (BT_UNIT, BT_UNIT))
    else:
        log("  Bluetooth : « %s », code PIN %s" % (c.bt_name, c.bt["pin"]))


def cmd_apply(c):
    if os.geteuid() != 0:
        die("« apply » doit être lancé avec sudo")
    if c.uid is None:
        die("l'utilisateur « %s » n'existe pas : lancez install.sh" % c.user)
    gid = pwd.getpwnam(c.user).pw_gid
    cmd_check(c)
    log("Démarrage (config.txt) :")
    apply_boot(c)
    log("Pile audio :")
    for rel, content in generated_files(c).items():
        p = os.path.join(c.home, rel)
        write_owned(p, content, c.uid, gid)
        log("  écrit " + p)

    systemctl_user(c, "daemon-reload")
    knob = yes(c.knob["enabled"])
    mop = yes(c.mopidy["enabled"])
    systemctl_user(c, "enable", "pipewire.socket", "pipewire.service", "wireplumber.service",
                   "audio-hub-init.service", "audio-hub-links.service")
    for unit, on in (("audio-hub-knob.service", knob), ("mopidy.service", mop),
                     ("mopidy-scan.timer", mop), ("mopidy-scan.path", mop)):
        if on:
            systemctl_user(c, "enable", unit)
        else:
            systemctl_user(c, "disable", "--now", unit)
    log("Redémarrage de la pile audio…")
    r = systemctl_user(c, "restart", "pipewire.service", "wireplumber.service")
    if r.returncode != 0:
        die("redémarrage PipeWire impossible :\n" + r.stderr)
    systemctl_user(c, "restart", "audio-hub-init.service", "audio-hub-links.service")
    if knob:
        systemctl_user(c, "restart", "audio-hub-knob.service")
    if mop:
        systemctl_user(c, "restart", "mopidy.service")
        systemctl_user(c, "restart", "mopidy-scan.timer", "mopidy-scan.path")
    log("Bluetooth :")
    apply_bluetooth(c)
    time.sleep(2)
    cmd_status(c)


def cmd_list(c):
    nodes = pw_nodes(c)
    if not nodes:
        die("PipeWire ne répond pas (sudo audio-hub status, journalctl _UID=$(id -u %s) --user-unit=pipewire)" % c.user)
    keys = ["node.description", "alsa.card_name", "alsa.long_card_name", "device.vendor.id",
            "device.product.id", "device.serial", "api.alsa.path", "audio.rate"]
    for cls in ("Audio/Sink", "Audio/Source"):
        print("\n==== %s ====" % ("SORTIES (Audio/Sink)" if cls == "Audio/Sink" else "ENTRÉES (Audio/Source)"))
        for nid, p, state in nodes:
            if p.get("media.class") != cls:
                continue
            print("\n  [%s] node.name = %s   (état : %s)" % (nid, p.get("node.name"), state))
            for k in keys:
                if k in p:
                    print("       %-20s = %s" % (k, p[k]))
    print("\nExemple de ligne à copier dans audio-hub.conf :")
    print("  match.node.name = ~alsa_output\\.usb-Fabricant_Produit.*")


def stream_formats(objs):
    """Flux de lecture (Mopidy, téléphones Bluetooth…) : [(nom, état, format négocié)]."""
    out = []
    for o in objs:
        if o.get("type") != "PipeWire:Interface:Node":
            continue
        info = o.get("info") or {}
        props = info.get("props") or {}
        if not str(props.get("media.class", "")).startswith("Stream/Output/Audio"):
            continue
        name = props.get("application.name") or props.get("node.description") or props.get("node.name", "?")
        f = ((info.get("params") or {}).get("Format") or [{}])[0]
        fmt = ("%s %s Hz %s canaux" % (f.get("format", "?"), f.get("rate", "?"), f.get("channels", "?"))
               if f else "format non négocié (pas de lecture)")
        out.append((str(name), str(info.get("state", "?")), fmt))
    return out


def cmd_status(c):
    nodes = pw_nodes(c)
    if not nodes:
        print("PipeWire ne répond pas pour l'utilisateur %s." % c.user)
        return
    by = {p.get("node.name"): (nid, p, st) for nid, p, st in nodes}
    print("\n== MASTER ==")
    if c.master in by:
        r = as_user(c, ["wpctl", "get-volume", str(by[c.master][0])])
        print("  %s [%s] %s" % (c.master, by[c.master][0], (r.stdout or "").strip()))
    else:
        print("  %s ABSENT (voir : journalctl _UID=$(id -u %s) --user-unit=pipewire)" % (c.master, c.user))
    for title, devs in (("SORTIES", c.outputs), ("ENTRÉES", c.inputs)):
        print("\n== %s ==" % title)
        for d in devs:
            if not d.enabled:
                print("  %-12s désactivée" % d.id)
            elif d.node_name in by:
                nid, p, st = by[d.node_name]
                print("  %-12s PRÉSENTE  [%s] %s  état=%s  %s Hz" % (
                    d.id, nid, d.description, st, p.get("audio.rate", "?")))
            else:
                print("  %-12s absente   (%s)" % (d.id, d.description))
    print("\n== FLUX (applications, téléphones) ==")
    flows = stream_formats(pw_dump(c) or [])
    for name, st, fmt in flows:
        print("  %-28s état=%-9s %s" % (name, st, fmt))
    if not flows:
        print("  (aucun)")
    print("\n== LIENS ==")
    r = as_user(c, ["pw-link", "-l"])
    shown = False
    for line in (r.stdout or "").splitlines():
        if "hub." in line or c.master in line:
            print("  " + line)
            shown = True
    if not shown:
        print("  (aucun)")
    if c.bt_enabled:
        print("\n== BLUETOOTH ==")
        phones = [(nid, p, st) for nid, p, st in nodes
                  if str(p.get("node.name", "")).startswith("bluez_input")]
        for nid, p, st in phones:
            print("  [%s] %s  état=%s  codec=%s  %s Hz" % (
                nid, p.get("node.description", "?"), st, p.get("api.bluez5.codec", "?"),
                p.get("audio.rate", "?")))
        if not phones:
            print("  aucun téléphone connecté (nom « %s », code PIN %s)" % (c.bt_name, c.bt["pin"]))
    for unit in ("audio-hub-knob.service", "mopidy.service"):
        r = systemctl_user(c, "is-active", unit)
        print("\n%s : %s" % (unit, (r.stdout or "").strip()), end="")
    if c.bt_enabled:
        r = subprocess.run(["systemctl", "is-active", BT_UNIT], text=True, capture_output=True)
        print("\n%s : %s" % (BT_UNIT, (r.stdout or "").strip()), end="")
    print()


# Volumes PipeWire (wpctl) : échelle cubique, amplitude = v³  =>  dB = 60·log10(v)
def wpvol_to_db(v):
    return 60.0 * math.log10(v) if v > 0 else float("-inf")


def db_to_wpvol(db):
    return (10 ** (db / 20.0)) ** (1.0 / 3.0)


def fmt_volume(v, muted=False):
    width = 30
    n = max(0, min(width, int(round(v * width))))
    db = wpvol_to_db(v)
    dbs = "  -∞ dB" if db == float("-inf") else "%+6.1f dB" % db
    return "MASTER %3d %%  [%s%s]  %s%s" % (round(v * 100), "#" * n, "-" * (width - n), dbs,
                                          "  (SOURDINE)" if muted else "          ")


def parse_wpctl_volume(out):
    m = re.search(r"Volume:\s*([0-9.]+)", out or "")
    return (float(m.group(1)) if m else None), ("MUTED" in (out or ""))


def state_file(c):
    return os.path.join(c.home, ".local/state/audio-hub/volume")


def read_saved_volume(c):
    try:
        with open(state_file(c)) as f:
            return float(f.read().strip())
    except (OSError, ValueError):
        return None


def save_volume(c, v):
    p = state_file(c)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        f.write("%.4f\n" % v)
    os.replace(tmp, p)


def cmd_init(c):
    """Lancé par audio-hub-init.service (utilisateur audio) après WirePlumber."""
    mid = None
    for _ in range(60):
        mid = node_id(c, c.master)
        if mid is not None:
            break
        time.sleep(1)
    if mid is None:
        die("MASTER n'est pas apparu en 60 s")
    subprocess.run(["wpctl", "set-default", str(mid)])
    v = read_saved_volume(c)
    if v is None:
        v = float(c.g["master.initial-volume"])
    v = max(0.0, min(v, c.max_volume))
    subprocess.run(["wpctl", "set-volume", str(mid), "%.4f" % v])
    log("MASTER [%s] par défaut, volume %.2f" % (mid, v))
    # Gains des entrées (nœuds de lecture des boucles)
    time.sleep(2)
    for d in c.inputs:
        if not d.enabled or not ("gain-db" in d.opts or "volume" in d.opts):
            continue
        if "gain-db" in d.opts:
            vol = db_to_wpvol(float(d.opts["gain-db"].replace("+", "")))
        else:
            vol = float(d.opts["volume"])
        nid = node_id(c, "hub.loop.%s.playback" % d.id)
        if nid is not None:
            subprocess.run(["wpctl", "set-volume", str(nid), "%.4f" % vol])
            log("entrée %s : gain %+.1f dB" % (d.id, wpvol_to_db(vol)))


# ----------------------------------------------------------------------------
#  Knob USB
# ----------------------------------------------------------------------------
class Master:
    def __init__(self, c):
        self.c = c
        self.id = None
        self.dirty_since = None

    def _wpctl(self, *args):
        for attempt in (0, 1):
            if self.id is None:
                self.id = node_id(self.c, self.c.master)
                if self.id is None:
                    log("MASTER introuvable")
                    return None
            r = subprocess.run(["wpctl"] + [a.replace("@ID@", str(self.id)) for a in args],
                               text=True, capture_output=True)
            if r.returncode == 0:
                return r.stdout
            self.id = None      # nœud recréé (redémarrage PipeWire) : on le recherche
        return None

    def change(self, delta):
        sign = "+" if delta > 0 else "-"
        self._wpctl("set-volume", "-l", "%.3f" % self.c.max_volume, "@ID@", "%.4f%s" % (abs(delta), sign))
        if delta > 0:
            self._wpctl("set-mute", "@ID@", "0")
        self.dirty_since = time.monotonic()
        v, muted = parse_wpctl_volume(self._wpctl("get-volume", "@ID@"))
        if v is not None:
            log("knob : " + fmt_volume(v, muted).strip())

    def toggle_mute(self):
        self._wpctl("set-mute", "@ID@", "toggle")
        v, muted = parse_wpctl_volume(self._wpctl("get-volume", "@ID@"))
        if v is not None:
            log("knob : " + fmt_volume(v, muted).strip())

    def maybe_save(self):
        if self.dirty_since and time.monotonic() - self.dirty_since > 3:
            out = self._wpctl("get-volume", "@ID@") or ""
            m = re.search(r"Volume:\s*([0-9.]+)", out)
            if m:
                save_volume(self.c, float(m.group(1)))
            self.dirty_since = None


def mopidy_rpc(c, method, **params):
    data = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    req = urllib.request.Request("http://127.0.0.1:%s/mopidy/rpc" % c.mopidy["http.port"],
                                 data=data, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=3) as r:
        return json.loads(r.read()).get("result")


def knob_candidates():
    """Périphériques d'entrée USB capables de piloter le volume, du meilleur au moins bon.
    Les entrées non USB sont ignorées : la Pi expose par exemple « vc4-hdmi-0/1 »
    (HDMI-CEC), qui déclarent aussi des touches de volume."""
    import evdev
    from evdev import ecodes as e
    found = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
            caps = d.capabilities()
        except OSError:
            continue
        if "usb" not in (d.phys or "").lower():
            continue
        keys = caps.get(e.EV_KEY, [])
        rels = caps.get(e.EV_REL, [])
        score = 0
        if e.KEY_VOLUMEUP in keys and e.KEY_VOLUMEDOWN in keys:
            score += 2
        if e.REL_DIAL in rels:
            score += 1
        if e.KEY_A in keys:          # un clavier complet : candidat de dernier recours
            score -= 1
        if score > 0:
            found.append((score, path, d.name, d.phys))
        d.close()
    found.sort(key=lambda t: -t[0])
    return found


def by_id_links():
    links = {}
    base = "/dev/input/by-id"
    if os.path.isdir(base):
        for n in os.listdir(base):
            links[os.path.realpath(os.path.join(base, n))] = os.path.join(base, n)
    return links


def cmd_knob_list(c):
    try:
        cands = knob_candidates()
    except ImportError:
        die("python3-evdev manquant (sudo apt install python3-evdev)")
    links = by_id_links()
    if not cands:
        print("Aucun périphérique avec touches de volume ou molette détecté.")
    for score, path, name, phys in cands:
        print("%s\n    nom : %s\n    chemin stable : %s" % (path, name, links.get(path, "(aucun lien by-id)")))
    print("\nÀ reporter dans [knob] device = … (de préférence le chemin /dev/input/by-id/…)")


def knob_wanted_paths(c):
    """Chemins à écouter : « auto » = tous les candidats USB ; sinon la liste
    (séparée par des virgules) des chemins configurés qui existent."""
    want = c.knob["device"].strip()
    if want.lower() == "auto":
        return [t[1] for t in knob_candidates() if t[0] >= 2]
    paths = []
    for w in (x.strip() for x in want.split(",")):
        if w and os.path.exists(w):
            paths.append(os.path.realpath(w))
    return paths


def cmd_knob(c):
    if not yes(c.knob["enabled"]):
        log("knob désactivé dans la configuration")
        return
    import evdev
    from evdev import ecodes as e
    step = float(c.knob["step"])
    press = c.knob["press"].strip().lower()
    grab = yes(c.knob["grab"])
    master = Master(c)
    PRESS_KEYS = {e.KEY_PLAYPAUSE, e.KEY_PLAY, e.KEY_PAUSE, e.KEY_ENTER, e.BTN_LEFT, e.BTN_0}
    devs = {}                  # chemin -> InputDevice
    last_scan = 0.0

    def drop(path, why):
        d = devs.pop(path, None)
        if d is not None:
            log("knob retiré : %s (%s)" % (path, why))
            try:
                d.close()
            except OSError:
                pass

    while True:
        # (Re)découverte toutes les 3 s : branchement / débranchement à chaud
        if time.monotonic() - last_scan > 3:
            last_scan = time.monotonic()
            wanted = set(knob_wanted_paths(c))
            for path in list(devs):
                if path not in wanted:
                    drop(path, "disparu")
            for path in wanted - set(devs):
                try:
                    d = evdev.InputDevice(path)
                    if grab:
                        try:
                            d.grab()
                        except OSError:
                            pass
                    devs[path] = d
                    log("knob : %s (%s)" % (d.name, path))
                except OSError:
                    pass
        if not devs:
            master.maybe_save()
            time.sleep(1)
            continue
        try:
            ready, _, _ = select.select([d.fd for d in devs.values()], [], [], 1.0)
        except (OSError, ValueError):
            for path in list(devs):
                drop(path, "erreur")
            continue
        if not ready:
            master.maybe_save()
            continue
        for path, d in list(devs.items()):
            if d.fd not in ready:
                continue
            try:
                events = list(d.read())
            except OSError as ex:
                drop(path, ex)
                continue
            for ev in events:
                if ev.type == e.EV_KEY and ev.value in (1, 2):
                    if ev.code == e.KEY_VOLUMEUP:
                        master.change(+step)
                    elif ev.code == e.KEY_VOLUMEDOWN:
                        master.change(-step)
                    elif ev.value == 1 and ev.code == e.KEY_MUTE:
                        master.toggle_mute()
                    elif ev.value == 1 and ev.code in PRESS_KEYS:
                        if press == "mute":
                            master.toggle_mute()
                        elif press == "playpause":
                            try:
                                st = mopidy_rpc(c, "core.playback.get_state")
                                mopidy_rpc(c, "core.playback.pause" if st == "playing"
                                           else "core.playback.play")
                            except Exception as ex:  # Mopidy absent : sans gravité
                                log("Mopidy injoignable : %s" % ex)
                elif ev.type == e.EV_REL and ev.code in (e.REL_DIAL, e.REL_WHEEL) and ev.value:
                    master.change(step * (1 if ev.value > 0 else -1))


def cmd_volume(c, args):
    mid = node_id(c, c.master)
    if mid is None:
        die("MASTER introuvable (sudo audio-hub status)")

    def get():
        return parse_wpctl_volume(as_user(c, ["wpctl", "get-volume", str(mid)]).stdout)

    if not args:
        v, muted = get()
        print(fmt_volume(v or 0.0, muted))
        return
    a = args[0].strip().lower()
    if a == "watch":
        print("Volume de MASTER en direct — tournez le knob (Ctrl+C pour quitter)")
        last = None
        try:
            while True:
                cur = get()
                if cur != last and cur[0] is not None:
                    sys.stdout.write("\r" + fmt_volume(*cur))
                    sys.stdout.flush()
                    last = cur
                time.sleep(0.15)
        except KeyboardInterrupt:
            print()
        return
    if a in ("mute", "unmute", "toggle"):
        as_user(c, ["wpctl", "set-mute", str(mid), {"mute": "1", "unmute": "0"}.get(a, "toggle")],
                check=True)
    else:
        m = re.fullmatch(r"([+-]?)([0-9]*\.?[0-9]+)(%?)", a)
        if not m:
            die("valeur invalide : %s (ex. +5%%, -5%%, 40%%, 0.4, mute)" % a)
        sign, num, pct = m.groups()
        val = float(num) / (100.0 if pct else 1.0)
        arg = "%.4f%s" % (val, sign) if sign else "%.4f" % val
        as_user(c, ["wpctl", "set-volume", "-l", "%.3f" % c.max_volume, str(mid), arg], check=True)
    v, muted = get()
    print(fmt_volume(v or 0.0, muted))


def pw_dump(c):
    r = as_user(c, ["pw-dump"])
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def pw_graph(c, objs=None):
    """(nœuds par nom, ports par id, liens) depuis pw-dump."""
    if objs is None:
        objs = pw_dump(c)
    if objs is None:
        return None
    nodes, ports, links = {}, {}, []
    for o in objs:
        t = o.get("type", "")
        info = o.get("info") or {}
        props = info.get("props") or {}
        if t == "PipeWire:Interface:Node":
            nodes[props.get("node.name")] = {"id": o["id"], "state": info.get("state")}
        elif t == "PipeWire:Interface:Port":
            ports[o["id"]] = (props.get("node.id"), props.get("port.name"), info.get("direction"))
        elif t == "PipeWire:Interface:Link":
            links.append((info.get("output-node-id"), info.get("output-port-id"),
                          info.get("input-node-id"), info.get("input-port-id")))
    return nodes, ports, links


def links_step(c, verbose=False, objs=None):
    """Un passage : relie / délie chaque boucle d'entrée selon l'état de sa capture."""
    g = pw_graph(c, objs)
    if g is None:
        return
    nodes, ports, links = g
    master = nodes.get(c.master)
    if master is None:
        return
    for d in c.inputs:
        if not d.enabled:
            continue
        play = nodes.get("hub.loop.%s.playback" % d.id)
        cap = nodes.get("hub.loop.%s.capture" % d.id)
        if play is None:
            continue
        # « running » : la capture reçoit réellement des données de l'appareil
        active = (cap is not None and cap["state"] == "running"
                  and ("hub.in.%s" % d.id) in nodes)
        out_ports = {name: pid for pid, (nid, name, dr) in ports.items()
                     if nid == play["id"] and dr == "output"}
        linked = [(op, ip) for (on, op, inn, ip) in links
                  if on == play["id"] and inn == master["id"]]
        if active and not linked:
            for name in sorted(out_ports):
                ch = name.split("_", 1)[-1]
                as_user(c, ["pw-link", "%s:%s" % ("hub.loop.%s.playback" % d.id, name),
                            "%s:playback_%s" % (c.master, ch)])
            log("entrée %s : reliée à %s" % (d.id, c.master))
        elif not active and linked:
            for (op, ip) in linked:
                as_user(c, ["pw-link", "-d", str(op), str(ip)])
            log("entrée %s : déliée de %s (appareil absent ou inactif)" % (d.id, c.master))
        elif verbose:
            log("entrée %s : %s" % (d.id, "reliée" if linked else "absente"))


def best_profile(dev):
    """Pour un appareil ALSA USB resté sur le profil « off » : (index, nom) du meilleur
    profil utilisable, sinon None."""
    info = dev.get("info") or {}
    props = info.get("props") or {}
    usb = props.get("device.bus") == "usb" or str(props.get("device.name", "")).startswith("alsa_card.usb-")
    if props.get("device.api") != "alsa" or not usb:
        return None
    params = info.get("params") or {}
    cur = (params.get("Profile") or [{}])[0]
    if cur.get("name") != "off":
        return None
    cands = [pr for pr in (params.get("EnumProfile") or [])
             if pr.get("name") not in (None, "off") and pr.get("available") != "no"]
    if not cands:
        return None
    # « pro-audio » (accès brut, sans mixeur ni canaux nommés) en dernier recours :
    # c'est le profil normal (analog-stereo…) que WirePlumber choisit au démarrage.
    pr = max(cands, key=lambda x: (x.get("name") != "pro-audio", x.get("priority", 0),
                                   x.get("available") == "yes"))
    return pr.get("index"), pr.get("name")


OFF_GRACE = 8.0      # secondes laissées à WirePlumber pour choisir lui-même le profil


def profiles_step(c, objs, last_try, now=None):
    """Un appareil USB revenu après une coupure (hub réinitialisé, DAC rallumé…) peut
    rester sur le profil « off » : sans sortie ni entrée. On active son meilleur profil,
    au plus une tentative toutes les 10 s par appareil.
    Un appareil qui vient d'apparaître est TOUJOURS « off » quelques instants, le
    temps que WirePlumber lui donne son profil : on ne s'en mêle qu'après OFF_GRACE
    secondes. (Intervenir trop tôt imposait « pro-audio » à la place du profil normal,
    et le DAC rallumé restait parfois muet.)"""
    now = time.monotonic() if now is None else now
    off_since = last_try.setdefault("off_since", {})
    seen = set()
    for o in objs:
        if o.get("type") != "PipeWire:Interface:Device":
            continue
        bp = best_profile(o)
        if bp is None:
            continue
        seen.add(o["id"])
        if now - off_since.setdefault(o["id"], now) < OFF_GRACE:
            continue
        if now - last_try.get(o["id"], -1e9) < 10:
            continue
        last_try[o["id"]] = now
        name = ((o.get("info") or {}).get("props") or {}).get("device.description", o["id"])
        as_user(c, ["wpctl", "set-profile", str(o["id"]), str(bp[0])])
        log("appareil « %s » resté sur le profil off : profil « %s » activé" % (name, bp[1]))
    for k in list(off_since):
        if k not in seen:
            del off_since[k]


def output_snapshot(c, objs, d):
    """État d'une sortie qui vient de (ré)apparaître, pour le journal : profil de
    l'appareil, état du nœud, flux de MASTER vers elle (état, volume, coupure), liens."""
    nodes, devs, links = {}, {}, []
    for o in objs:
        t = o.get("type")
        info = o.get("info") or {}
        if t == "PipeWire:Interface:Node":
            nodes[(info.get("props") or {}).get("node.name")] = o
        elif t == "PipeWire:Interface:Device":
            devs[o["id"]] = o
        elif t == "PipeWire:Interface:Link":
            links.append(info)
    n = nodes.get(d.node_name)
    if n is None:
        return "sortie %s : absente" % d.id
    ni = n.get("info") or {}
    dev = devs.get((ni.get("props") or {}).get("device.id"))
    prof = "?"
    if dev:
        prof = (((dev.get("info") or {}).get("params") or {}).get("Profile") or [{}])[0].get("name", "?")
    out = "sortie %s : profil=%s état=%s" % (d.id, prof, ni.get("state"))
    st = nodes.get("output.%s_%s" % (c.master, d.node_name))
    if st is None:
        return out + " ; flux de %s vers elle : ABSENT" % c.master
    si = st.get("info") or {}
    pr = ((si.get("params") or {}).get("Props") or [{}])[0]
    vols = pr.get("channelVolumes")
    nl = sum(1 for l in links if l.get("output-node-id") == st["id"] and l.get("input-node-id") == n["id"])
    return out + " ; flux de %s : état=%s volume=%s muet=%s liens=%d" % (
        c.master, si.get("state"), ",".join("%.2f" % v for v in vols) if vols else "?",
        pr.get("mute"), nl)


def cmd_links(c, args):
    if args and args[0] == "once":
        objs = pw_dump(c) or []
        links_step(c, verbose=True, objs=objs)
        profiles_step(c, objs, {})
        return
    log("audio-hub links : surveillance des entrées et des profils USB")
    last_try = {}
    present, pending = None, {}       # sorties présentes ; état à journaliser (id -> instant)
    while True:
        try:
            objs = pw_dump(c)
            if objs is not None:
                links_step(c, objs=objs)
                profiles_step(c, objs, last_try)
                names = {((o.get("info") or {}).get("props") or {}).get("node.name") for o in objs
                         if o.get("type") == "PipeWire:Interface:Node"}
                now = time.monotonic()
                cur = {d.id for d in c.outputs if d.enabled and d.node_name in names}
                if present is not None:
                    for i in cur - present:
                        log("sortie %s : (ré)apparue" % i)
                        pending[i] = now + 6
                    for i in present - cur:
                        log("sortie %s : disparue" % i)
                        pending.pop(i, None)
                present = cur
                for d in c.outputs:
                    if d.id in pending and now >= pending[d.id]:
                        del pending[d.id]
                        log(output_snapshot(c, objs, d))
        except Exception as ex:          # PipeWire en redémarrage, etc.
            log("links : %s" % ex)
        time.sleep(1.5)


# =============================================================================
#  Bluetooth : agent de jumelage BlueZ (service système, root)
# =============================================================================
#  Un téléphone moderne jumelle par défaut SANS code (« Secure Simple Pairing » :
#  simple confirmation). Pour qu'il DEMANDE un code, le contrôleur de la Pi passe
#  en jumelage « classique » par code PIN (SSP désactivé) ; l'agent ci-dessous
#  répond avec le code de la configuration. Un téléphone qui saisit un autre code
#  échoue. Toute demande de jumelage sans code est refusée, même si le SSP se
#  trouvait réactivé (redémarrage de bluetoothd) : jamais d'appairage sans PIN.
AGENT_PATH = "/org/pisoundserver/bluetooth/agent"


# Interface « mgmt » du noyau (socket Bluetooth, canal de contrôle) : c'est ce
# qu'utilise btmgmt, mais btmgmt se bloque sans terminal (service systemd).
MGMT_SETTINGS = {0x1: "powered", 0x2: "connectable", 0x4: "fast-connectable",
                 0x8: "discoverable", 0x10: "bondable", 0x20: "link-security",
                 0x40: "ssp", 0x80: "br/edr", 0x200: "le", 0x400: "advertising",
                 0x800: "secure-conn"}
MGMT_READ_INFO, MGMT_SET_POWERED, MGMT_SET_SSP = 0x0004, 0x0005, 0x000B
MGMT_SET_CLASS, MGMT_SET_SC = 0x000E, 0x002D


def mgmt_parse_info(data):
    """Réponse de « Read Controller Information » -> {"settings": {...}, "class": int}."""
    cur = struct.unpack_from("<I", data, 13)[0]
    return {"settings": {n for b, n in MGMT_SETTINGS.items() if cur & b},
            "class": int.from_bytes(data[17:20], "little")}


HCI_DEV_NONE = 0xFFFF
HCI_CHANNEL_RAW, HCI_CHANNEL_MONITOR, HCI_CHANNEL_CONTROL = 0, 2, 3


def hci_socket(dev, channel):
    """Socket Bluetooth HCI lié à (appareil, canal). Python ne sait pas lier un canal
    HCI : appel direct de socket()/bind() de la libc."""
    import ctypes
    AF_BLUETOOTH, BTPROTO_HCI = 31, 1
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.socket(AF_BLUETOOTH, socket.SOCK_RAW | socket.SOCK_CLOEXEC, BTPROTO_HCI)
    if fd < 0:
        raise OSError(ctypes.get_errno(), "socket HCI")
    addr = struct.pack("=HHH", AF_BLUETOOTH, dev, channel)
    if libc.bind(fd, ctypes.create_string_buffer(addr, len(addr)), len(addr)) < 0:
        err = ctypes.get_errno()
        os.close(fd)
        raise OSError(err, "bind HCI (canal %d)" % channel)
    return fd


class Mgmt:
    def __init__(self):
        self.fd = hci_socket(HCI_DEV_NONE, HCI_CHANNEL_CONTROL)

    def close(self):
        os.close(self.fd)

    def cmd(self, opcode, index, params=b"", timeout=5.0):
        """Envoie une commande, renvoie (statut, données). Statut 0 = succès."""
        os.write(self.fd, struct.pack("<HHH", opcode, index, len(params)) + params)
        end = time.monotonic() + timeout
        while True:
            left = end - time.monotonic()
            if left <= 0 or not select.select([self.fd], [], [], left)[0]:
                raise TimeoutError("mgmt 0x%04x sans réponse" % opcode)
            pkt = os.read(self.fd, 4096)
            if len(pkt) < 9:
                continue
            ev, idx, _ = struct.unpack_from("<HHH", pkt, 0)
            op, status = struct.unpack_from("<HB", pkt, 6)
            if ev in (0x0001, 0x0002) and op == opcode and idx == index:
                return status, pkt[9:]

    def info(self, index):
        st, d = self.cmd(MGMT_READ_INFO, index)
        if st != 0 or len(d) < 20:
            raise OSError("lecture du contrôleur impossible (statut %d)" % st)
        return mgmt_parse_info(d)

    def set(self, opcode, index, *vals):
        st, _ = self.cmd(opcode, index, bytes(vals))
        return st


def bt_make_agent(dbus, bus, pin, dev_name, is_paired):
    """Construit l'agent org.bluez.Agent1. « dbus » est passé en paramètre (tests)."""
    class Rejected(dbus.DBusException):
        _dbus_error_name = "org.bluez.Error.Rejected"

    meth = dbus.service.method
    IF = "org.bluez.Agent1"

    class Agent(dbus.service.Object):
        @meth(IF, in_signature="", out_signature="")
        def Release(self):
            log("agent libéré par bluetoothd")

        @meth(IF, in_signature="o", out_signature="s")
        def RequestPinCode(self, device):
            log("%s : code PIN demandé (jumelage)" % dev_name(device))
            return pin

        @meth(IF, in_signature="os", out_signature="")
        def DisplayPinCode(self, device, code):
            raise Rejected("code PIN imposé par la configuration")

        @meth(IF, in_signature="o", out_signature="u")
        def RequestPasskey(self, device):
            log("%s : jumelage sans code PIN refusé" % dev_name(device))
            raise Rejected("code PIN obligatoire")

        @meth(IF, in_signature="ouq", out_signature="")
        def DisplayPasskey(self, device, passkey, entered):
            pass

        @meth(IF, in_signature="ou", out_signature="")
        def RequestConfirmation(self, device, passkey):
            log("%s : jumelage sans code PIN refusé" % dev_name(device))
            raise Rejected("code PIN obligatoire")

        @meth(IF, in_signature="o", out_signature="")
        def RequestAuthorization(self, device):
            log("%s : jumelage sans code PIN refusé" % dev_name(device))
            raise Rejected("code PIN obligatoire")

        @meth(IF, in_signature="os", out_signature="")
        def AuthorizeService(self, device, uuid):
            if is_paired(device):
                return
            log("%s : service refusé (appareil non jumelé)" % dev_name(device))
            raise Rejected("appareil non jumelé")

        @meth(IF, in_signature="", out_signature="")
        def Cancel(self):
            log("jumelage annulé")

    return Agent(bus, AGENT_PATH)


def rfkill_unblock():
    for d in glob.glob("/sys/class/rfkill/rfkill*"):
        try:
            if open(d + "/type").read().strip() != "bluetooth":
                continue
            if open(d + "/soft").read().strip() == "1":
                with open(d + "/soft", "w") as f:
                    f.write("0")
                log("Bluetooth débloqué (rfkill)")
        except OSError:
            pass


# -----------------------------------------------------------------------------
#  Contournement d'un défaut du noyau (constaté en 6.18) : un téléphone Android
#  qui jumelle avec un code PIN le fait PENDANT l'établissement de la connexion.
#  La clé arrive avant « Connect Complete » ; le noyau (hci_link_key_notify_evt
#  -> hci_conn_drop, délai 0) abandonne alors cette connexion entrante comme si
#  elle était sortante et l'oublie, alors que le contrôleur la garde ouverte : le
#  téléphone parle dans le vide puis efface le jumelage. On écoute le moniteur
#  HCI (comme btmon) et, dans ce cas précis, on coupe nous-mêmes la connexion
#  orpheline : le téléphone, qui a gardé la clé, se reconnecte normalement.
# -----------------------------------------------------------------------------
HCI_MON_EVENT_PKT, HCI_MON_CTRL_EVENT = 3, 17
HCI_EV_CONN_COMPLETE, HCI_EV_DISCONN_COMPLETE, HCI_EV_LINK_KEY_NOTIFY = 0x03, 0x05, 0x18
MGMT_EV_CONNECT_FAILED = 0x000D


def bdaddr_str(b):
    return ":".join("%02X" % x for x in reversed(b))


class OrphanWatch:
    """Reçoit les paquets du moniteur HCI ; renvoie [(index, handle, adresse)] des
    connexions à couper."""

    def __init__(self, window=10.0, clock=time.monotonic):
        self.window, self.clock = window, clock
        self.early = {}        # (index, adresse) -> instant de la clé reçue trop tôt
        self.handles = {}      # (index, adresse) -> handle (Connect Complete)

    def feed(self, opcode, index, data):
        now = self.clock()
        out = []
        if opcode == HCI_MON_EVENT_PKT and len(data) >= 2:
            ev, p = data[0], data[2:]
            if ev == HCI_EV_LINK_KEY_NOTIFY and len(p) >= 6:
                key = (index, bytes(p[:6]))
                if key not in self.handles:          # connexion pas encore établie
                    self.early[key] = now
            elif ev == HCI_EV_CONN_COMPLETE and len(p) >= 9 and p[0] == 0:
                self.handles[(index, bytes(p[3:9]))] = struct.unpack_from("<H", p, 1)[0] & 0x0FFF
            elif ev == HCI_EV_DISCONN_COMPLETE and len(p) >= 3:
                h = struct.unpack_from("<H", p, 1)[0] & 0x0FFF
                for k, v in list(self.handles.items()):
                    if k[0] == index and v == h:
                        del self.handles[k]
                        self.early.pop(k, None)
        elif opcode == HCI_MON_CTRL_EVENT and len(data) >= 12:
            mev = struct.unpack_from("<H", data, 4)[0]
            if mev == MGMT_EV_CONNECT_FAILED:
                key = (index, bytes(data[6:12]))
                t = self.early.pop(key, None)
                h = self.handles.pop(key, None)
                if t is not None and h is not None and now - t <= self.window:
                    out.append((index, h, bdaddr_str(key[1])))
        for k, t in list(self.early.items()):
            if now - t > 60:
                del self.early[k]
        return out


def hci_disconnect(index, handle, reason=0x13):
    """Commande HCI « Disconnect » envoyée directement au contrôleur."""
    fd = hci_socket(index, HCI_CHANNEL_RAW)
    try:
        os.write(fd, bytes([0x01, 0x06, 0x04, 3]) + struct.pack("<HB", handle, reason))
    finally:
        os.close(fd)


def bt_controller_fix(mgmt, index):
    """SSP coupé (code PIN obligatoire) et classe « haut-parleur ». Le SSP ne peut être
    désactivé que contrôleur éteint : extinction brève (une seule fois, au démarrage)."""
    info = mgmt.info(index)
    if "ssp" in info["settings"]:
        log("hci%d : jumelage sans code (SSP) actif -> désactivé, code PIN obligatoire" % index)
        mgmt.set(MGMT_SET_POWERED, index, 0)
        mgmt.set(MGMT_SET_SC, index, 0)
        st = mgmt.set(MGMT_SET_SSP, index, 0)
        mgmt.set(MGMT_SET_POWERED, index, 1)
        info = mgmt.info(index)
        if "ssp" in info["settings"]:
            log("hci%d : le contrôleur refuse de couper le SSP (statut %d) ; les jumelages "
                "sans code restent refusés par l'agent" % (index, st))
        else:
            log("hci%d : jumelage par code PIN en place" % index)
    if (info["class"] & 0x1ffc) != BT_CLASS:
        mgmt.set(MGMT_SET_CLASS, index, BT_CLASS >> 8, BT_CLASS & 0xfc)


def cmd_bluetooth(c):
    if not c.bt_enabled:
        log("Bluetooth désactivé dans %s ([bluetooth] enabled = no)" % c.path)
        return
    if os.geteuid() != 0:
        die("« bluetooth » tourne en service système (root) : systemctl status " + BT_UNIT)
    try:
        import dbus
        import dbus.service
        import dbus.mainloop.glib
        from gi.repository import GLib
    except ImportError:
        die("python3-dbus / python3-gi absents : sudo bash /opt/pi-sound-server/install.sh")
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    PROPS = "org.freedesktop.DBus.Properties"
    pin, name, disc = c.bt["pin"], c.bt_name, yes(c.bt["discoverable"])
    state = {"registered": False, "lost": False, "noadapter": False}
    try:
        mgmt = Mgmt()
    except OSError as ex:
        die("interface de gestion Bluetooth du noyau inaccessible : %s" % ex)

    def dev_get(path):
        try:
            return dbus.Interface(bus.get_object("org.bluez", path), PROPS).GetAll("org.bluez.Device1")
        except dbus.DBusException:
            return {}

    def dev_name(path):
        p = dev_get(path)
        return "« %s » (%s)" % (p.get("Alias", "?"), p.get("Address", path))

    def is_paired(path):
        p = dev_get(path)
        return bool(p.get("Paired")) or bool(p.get("Trusted"))

    def trust(path):
        try:
            dbus.Interface(bus.get_object("org.bluez", path), PROPS).Set(
                "org.bluez.Device1", "Trusted", dbus.Boolean(True))
            log("%s : jumelé, marqué de confiance (reconnexion automatique)" % dev_name(path))
        except dbus.DBusException as ex:
            log("confiance impossible pour %s : %s" % (path, ex))

    agent = bt_make_agent(dbus, bus, pin, dev_name, is_paired)

    def on_props(iface, changed, invalidated, path=None):
        if iface == "org.bluez.Device1" and changed.get("Paired"):
            if not dev_get(path).get("Trusted"):
                trust(path)

    bus.add_signal_receiver(on_props, dbus_interface=PROPS, signal_name="PropertiesChanged",
                            arg0="org.bluez.Device1", path_keyword="path")
    loop = GLib.MainLoop()

    def on_owner(nm, old, new):
        if not new:
            log("bluetoothd s'est arrêté : redémarrage du service")
            state["lost"] = True
            loop.quit()

    bus.add_signal_receiver(on_owner, dbus_interface="org.freedesktop.DBus",
                            signal_name="NameOwnerChanged", arg0="org.bluez")

    def reconcile():
        try:
            rfkill_unblock()
            objs = dbus.Interface(bus.get_object("org.bluez", "/"),
                                  "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
        except dbus.DBusException as ex:
            log("bluetoothd injoignable : %s" % ex)
            return True
        adapters = [p for p, i in objs.items() if "org.bluez.Adapter1" in i]
        if not adapters:
            if not state["noadapter"]:
                log("aucun adaptateur Bluetooth (dtoverlay=disable-bt ? redémarrage requis ?)")
                state["noadapter"] = True
            return True
        state["noadapter"] = False
        for path in adapters:
            m = re.search(r"hci(\d+)$", str(path))
            if m:
                try:
                    bt_controller_fix(mgmt, int(m.group(1)))
                except (OSError, TimeoutError) as ex:
                    log("contrôleur %s : %s" % (path, ex))
            cur = dbus.Interface(bus.get_object("org.bluez", path), PROPS).GetAll("org.bluez.Adapter1")
            ap = dbus.Interface(bus.get_object("org.bluez", path), PROPS)
            for k, v in (("Powered", dbus.Boolean(True)), ("Alias", dbus.String(name)),
                         ("PairableTimeout", dbus.UInt32(0)), ("Pairable", dbus.Boolean(True)),
                         ("DiscoverableTimeout", dbus.UInt32(0)),
                         ("Discoverable", dbus.Boolean(disc))):
                if cur.get(k) != v:
                    try:
                        ap.Set("org.bluez.Adapter1", k, v)
                    except dbus.DBusException as ex:
                        log("adaptateur %s : %s impossible (%s)" % (path, k, ex))
        for path, ifs in objs.items():
            d = ifs.get("org.bluez.Device1")
            if d and d.get("Paired") and not d.get("Trusted"):
                trust(path)
        if not state["registered"]:
            am = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")
            try:
                am.RegisterAgent(AGENT_PATH, "KeyboardDisplay")
                am.RequestDefaultAgent(AGENT_PATH)
                state["registered"] = True
                log("prêt : « %s », %s, jumelage par code PIN" % (
                    name, "visible de tous" if disc else "invisible (appareils déjà jumelés)"))
            except dbus.DBusException as ex:
                log("enregistrement de l'agent impossible : %s" % ex)
        return True

    watch = OrphanWatch()
    try:
        mon = hci_socket(HCI_DEV_NONE, HCI_CHANNEL_MONITOR)
    except OSError as ex:
        mon = None
        log("moniteur HCI indisponible (%s) : jumelage Android par code PIN non rattrapé" % ex)

    def on_monitor(fd, cond):
        try:
            pkt = os.read(fd, 4096)
        except OSError:
            return True
        if len(pkt) >= 6:
            op, idx, ln = struct.unpack_from("<HHH", pkt, 0)
            for index, handle, addr in watch.feed(op, idx, pkt[6:6 + ln]):
                log("%s : connexion abandonnée par le noyau juste après le jumelage "
                    "(handle %d) : coupée pour que le téléphone se reconnecte" % (addr, handle))
                try:
                    hci_disconnect(index, handle)
                except OSError as ex:
                    log("coupure impossible : %s" % ex)
        return True

    if mon is not None:
        GLib.io_add_watch(mon, GLib.PRIORITY_DEFAULT, GLib.IO_IN, on_monitor)
    reconcile()
    GLib.timeout_add_seconds(30, reconcile)
    loop.run()
    del agent
    sys.exit(1 if state["lost"] else 0)


def cmd_boot_config(c, path):
    sys.stdout.write(boot_transform(open(path, encoding="utf-8").read(), c))


# =============================================================================
def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        head = open(__file__, encoding="utf-8").read().split("import configparser")[0]
        print("\n".join(l[2:] for l in head.splitlines()[1:] if l.startswith("#") and "====" not in l))
        return
    cmd = args[0]
    c = Config()
    if cmd == "check":
        cmd_check(c)
    elif cmd == "generate":
        if len(args) < 2:
            die("usage : audio-hub generate DOSSIER")
        cmd_generate(c, args[1])
    elif cmd == "apply":
        cmd_apply(c)
    elif cmd == "list":
        cmd_list(c)
    elif cmd == "status":
        cmd_status(c)
    elif cmd == "init":
        cmd_init(c)
    elif cmd == "knob":
        cmd_knob(c)
    elif cmd == "links":
        cmd_links(c, args[1:])
    elif cmd == "bluetooth":
        cmd_bluetooth(c)
    elif cmd == "volume":
        cmd_volume(c, args[1:])
    elif cmd == "diag":
        os.execvp("audio-hub-diag", ["audio-hub-diag"] + args[1:])
    elif cmd == "knob-list":
        cmd_knob_list(c)
    elif cmd == "boot-config":
        if len(args) < 2:
            die("usage : audio-hub boot-config FICHIER")
        cmd_boot_config(c, args[1])
    else:
        die("commande inconnue : %s (voir audio-hub help)" % cmd)


if __name__ == "__main__":
    main()
